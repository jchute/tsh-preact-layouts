{
  "compilerOptions": {
    "baseUrl": "src",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@Assets/*": ["./Assets/*"],
      "@Components/*": ["./Components/*"],
      "@Screens/*": ["./Screens/*"],
      "@State/*": ["./State/*"],
      "@Utils/*": ["./Utils/*"]
    }
  },
  "include": ["src"]
}
